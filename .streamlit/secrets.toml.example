# Exemple de secrets pour Streamlit Cloud
# Copiez ce contenu dans l'interface Streamlit Cloud (Settings > Secrets)

# Exemple Postgres
# [postgres]
# host = "<host>"
# port = 5432
# dbname = "<db>"
# user = "<user>"
# password = "<password>"

# Exemple API
# API_TOKEN = "<votre_token>"

# Token pour l'API des indicateurs
# api_indicateurs_token = "<votre_token_api_indicateurs>"

# Albert API (https://albert.api.etalab.gouv.fr) — page test variance
# ALBERT_API_KEY = "<votre_jeton>"
